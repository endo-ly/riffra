{
  "schema_version": 6,
  "metadata": {
    "name": "Sidechain Ducking",
    "author": "Riffra",
    "description": "Bundle import reference instrument"
  },
  "performance": {
    "mode": "polyphonic",
    "polyphony": 16,
    "voice_stealing": "quietest_releasing_then_oldest"
  },
  "layers": [
    {
      "id": "body",
      "enabled": true,
      "trigger": {
        "event": "note_on",
        "key_min": 0,
        "key_max": 127,
        "velocity_min": 1,
        "velocity_max": 127
      },
      "gain_db": -14,
      "pan": 0,
      "tuning_cents": 0,
      "envelope": {
        "attack_seconds": 0.005,
        "decay_seconds": 0.18,
        "sustain_level": 0.65,
        "release_seconds": 0.3
      },
      "generator": {
        "oscillator": {
          "waveform": {
            "type": "saw"
          },
          "phase_reset": true,
          "phase": 0
        }
      }
    }
  ],
  "voice_processors": [
    {
      "type": "filter",
      "id": "tone",
      "cutoff_hz": 12000,
      "resonance": 0.12
    }
  ],
  "global_processors": [
    {
      "type": "frequency_shifter",
      "id": "shift",
      "shift_hz": 180,
      "mix": 1
    },
    {
      "type": "compressor",
      "id": "duck",
      "threshold_db": -24,
      "ratio": 6,
      "attack_ms": 8,
      "release_ms": 180,
      "knee_db": 6,
      "makeup_gain_db": 0,
      "mix": 1,
      "detector": "external_audio"
    }
  ],
  "modulation": {
    "sources": [],
    "routes": [
      {
        "source": "velocity",
        "target": "layer.body.gain",
        "depth": {
          "value": 5.76000023,
          "unit": "decibels"
        },
        "curve": "linear"
      },
      {
        "source": "velocity",
        "target": "voice.processor.tone.cutoff",
        "depth": {
          "value": 0.797262728,
          "unit": "octaves"
        },
        "curve": "linear"
      }
    ]
  },
  "macros": [],
  "vectors": [],
  "external_audio": {
    "channels": "stereo"
  }
}
