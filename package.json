{
  "name": "riffra-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @riffra/desktop",
    "build": "npm run build --workspace @riffra/desktop",
    "preview": "npm run preview --workspace @riffra/desktop",
    "test": "npm run test --workspace @riffra/desktop",
    "tauri": "npm run tauri --workspace @riffra/desktop",
    "dev:tauri": "npm run dev:tauri --workspace @riffra/desktop",
    "gen:types": "npm run gen:types --workspace @riffra/desktop",
    "check": "npm run check --workspace @riffra/desktop",
    "typecheck": "npm run typecheck --workspace @riffra/desktop",
    "lint": "eslint apps/desktop",
    "lint:fix": "eslint apps/desktop --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --tsConfig apps/desktop/tsconfig.app.json --include=files,dependencies --no-config-hints",
    "verify": "node scripts/verify.mjs",
    "verify:native": "node scripts/verify.mjs --native",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.64.0"
  }
}
